{
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": "python ${CLAUDE_PROJECT_DIR}/scripts/claude_stop_hook.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/scripts/gate_pretooluse.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/scripts/noticeboard.py check --stdin-json --format claude-hook --event SessionStart",
            "timeout": 10,
            "statusMessage": "Checking the agent noticeboard..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/scripts/noticeboard.py check --stdin-json --format claude-hook --event UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/scripts/noticeboard.py check --stdin-json --format claude-hook --event PostToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
