{
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": "python ${CLAUDE_PROJECT_DIR}/scripts/claude_stop_hook.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/scripts/gate_pretooluse.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/noticeboard.py\"; [ -f \"$f\" ] && python \"$f\" check --stdin-json --format claude-hook --event SessionStart || true",
            "timeout": 10,
            "statusMessage": "Checking the agent noticeboard..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/noticeboard.py\"; [ -f \"$f\" ] && python \"$f\" check --stdin-json --format claude-hook --event UserPromptSubmit || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/noticeboard.py\"; [ -f \"$f\" ] && python \"$f\" check --stdin-json --format claude-hook --event PostToolUse || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
